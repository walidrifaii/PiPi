// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Service area for polygon-based location checks (same `code` as `merchants.city_code`).
model ServiceArea {
  id               String   @id @default(uuid()) @db.Uuid
  code             String   @unique @db.VarChar(64)
  name             String?  @db.VarChar(255)
  /// GeoJSON Polygon (or Feature / FeatureCollection containing a Polygon). When null, no polygon gate for this code.
  boundaryGeoJson  Json?    @map("boundary_geo_json")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@map("service_areas")
}

model MerchantType {
  id            String     @id @default(uuid()) @db.Uuid
  code          String     @unique @db.VarChar(64)
  name          String     @db.VarChar(255)
  nameAr        String?    @map("name_ar") @db.VarChar(255)
  description   String?    @db.Text
  descriptionAr String?    @map("description_ar") @db.Text
  imageUrl    String?    @map("image_url") @db.VarChar(500)
  isActive    Boolean    @default(true) @map("is_active")
  sortOrder   Int        @default(0) @map("sort_order")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  merchants   Merchant[]

  @@map("merchant_types")
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  fullName     String?       @map("full_name") @db.VarChar(255)
  dateOfBirth  DateTime?     @map("date_of_birth") @db.Date
  phone        String        @unique @db.VarChar(50)
  email        String?       @unique @db.VarChar(255)
  passwordHash String?       @map("password_hash")
  isActive     Boolean       @default(true) @map("is_active")
  /// Set when the customer requests account deletion; account is inactive until grace ends or they sign in again.
  deletionRequestedAt DateTime? @map("deletion_requested_at")
  /// FCM device token for push notifications (cleared on logout).
  fcmToken     String?       @map("fcm_token") @db.VarChar(512)
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  orders          Order[]
  pickupOrders    PickupOrder[]
  addresses       UserAddress[]
  notifications   UserNotification[]
  couponUsages    CouponUsage[]

  @@map("users")
}

/// In-app notification inbox for customers (order updates, promos, system messages).
model UserNotification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// ORDER_STATUS | SPECIAL_OFFER | SYSTEM_UPDATE | SECURITY_ALERT
  category  String   @db.VarChar(32)
  title     String   @db.VarChar(255)
  titleAr   String?  @map("title_ar") @db.VarChar(255)
  message   String   @db.Text
  messageAr String?  @map("message_ar") @db.Text
  /// INBOX (default) or DEVELOPER_LAB for test/dev notifications.
  channel   String   @default("INBOX") @db.VarChar(32)
  isRead    Boolean  @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  /// Deep-link payload: orderId, promoCode, etc.
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, channel, createdAt(sort: Desc)])
  @@index([userId, isRead])
  @@map("user_notifications")
}

/// Super-admin mass notification campaign (processed in batches of users).
model NotificationBroadcast {
  id               String   @id @default(uuid()) @db.Uuid
  title            String   @db.VarChar(255)
  titleAr          String?  @map("title_ar") @db.VarChar(255)
  message          String   @db.Text
  messageAr        String?  @map("message_ar") @db.Text
  category         String   @default("SPECIAL_OFFER") @db.VarChar(32)
  status           String   @default("IN_PROGRESS") @db.VarChar(20)
  /// Cursor: last user id included in a completed batch.
  lastUserId       String?  @map("last_user_id") @db.Uuid
  totalUsers       Int      @default(0) @map("total_users")
  usersProcessed   Int      @default(0) @map("users_processed")
  inboxCreated     Int      @default(0) @map("inbox_created")
  pushSuccessCount Int      @default(0) @map("push_success_count")
  pushFailureCount Int      @default(0) @map("push_failure_count")
  sendPush         Boolean  @default(true) @map("send_push")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([status, createdAt(sort: Desc)])
  @@map("notification_broadcasts")
}

/// Saved delivery location for a customer (referenced at checkout by id).
model UserAddress {
  id                  String   @id @default(uuid()) @db.Uuid
  userId              String   @map("user_id") @db.Uuid
  label               String?  @db.VarChar(100)
  addressLine         String   @map("address_line") @db.VarChar(500)
  latitude            Decimal  @db.Decimal(10, 7)
  longitude           Decimal  @db.Decimal(10, 7)
  isDefault           Boolean  @default(false) @map("is_default")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders              Order[]
  pickupFroms         PickupOrder[] @relation("PickupFromAddress")
  pickupTos           PickupOrder[] @relation("PickupToAddress")

  @@index([userId])
  @@map("user_addresses")
}

model Driver {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String?  @map("full_name") @db.VarChar(255)
  phone        String   @db.VarChar(50)
  email        String?  @unique @db.VarChar(255)
  passwordHash String   @map("password_hash")
  vehicleType  String?  @map("vehicle_type") @db.VarChar(100)
  status       String?  @db.VarChar(50)
  isActive     Boolean  @default(true) @map("is_active")
  /// FCM device token for delivery chat / order alerts.
  fcmToken     String?  @map("fcm_token") @db.VarChar(512)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  orders       Order[]
  pickupOrders PickupOrder[]
  earningsSettlements EarningsSettlement[]

  @@map("drivers")
}

model Merchant {
  id              String       @id @default(uuid()) @db.Uuid
  name            String       @db.VarChar(255)
  nameAr          String?      @map("name_ar") @db.VarChar(255)
  merchantTypeId  String       @map("merchant_type_id") @db.Uuid
  merchantType    MerchantType @relation(fields: [merchantTypeId], references: [id], onDelete: Restrict)
  email           String?      @unique @db.VarChar(255)
  phone        String?            @unique @db.VarChar(50)
  passwordHash String?            @map("password_hash")
  imageUrl     String?            @map("image_url") @db.VarChar(500)
  coverImageUrl String?           @map("cover_image_url") @db.VarChar(500)
  /// Service area for catalog filtering (e.g. TRIPOLI). Stored uppercase.
  cityCode     String?            @map("city_code") @db.VarChar(64)
  /// Store latitude (WGS84) for near-me ordering and optional radius.
  latitude     Decimal?           @db.Decimal(10, 7)
  /// Store longitude (WGS84).
  longitude    Decimal?           @db.Decimal(10, 7)
  /// Store OPEN (true) vs CLOSED (false); merchant sets via PATCH /merchants/me/status.
  isActive     Boolean            @default(true) @map("is_active")
  /// Admin-controlled kill-switch: false = completely hidden from all public responses.
  isEnabled    Boolean            @default(true) @map("is_enabled")
  /// IANA timezone for working hours (e.g. Asia/Beirut for Lebanon). Required when useWorkingHours is true.
  timezone     String?            @db.VarChar(64)
  /// When true, customers only see the store open during merchant_working_intervals (and isActive must be true).
  useWorkingHours Boolean         @default(false) @map("use_working_hours")
  /// FCM device token for new-order push (dashboard / mobile).
  fcmToken     String?            @map("fcm_token") @db.VarChar(512)
  /// Override platform food-share % for this store; null = use global app_settings default.
  foodSharePercent Decimal?       @map("food_share_percent") @db.Decimal(5, 2)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  orders       Order[]
  categories   MerchantCategory[]
  workingIntervals MerchantWorkingInterval[]
  deliveryTime MerchantDeliveryTime?
  offers       MerchantOffer[]
  bundles      MerchantBundle[]
  earningsSettlements EarningsSettlement[]

  @@index([merchantTypeId])
  @@index([cityCode])
  @@map("merchants")
}

/// Customer-facing promo card for a store (super admin). Display only — checkout uses product prices.
model MerchantOffer {
  id              String   @id @default(uuid()) @db.Uuid
  merchantId      String   @map("merchant_id") @db.Uuid
  title           String?  @db.VarChar(255)
  titleAr         String?  @map("title_ar") @db.VarChar(255)
  /// Percentage off list price (e.g. 10 = 10% off).
  discountPercent Decimal  @map("discount_percent") @db.Decimal(5, 2)
  /// Legacy optional upload; API display image comes from merchant cover/logo.
  imageUrl        String?  @map("image_url") @db.VarChar(500)
  isActive        Boolean  @default(true) @map("is_active")
  /// When the promo becomes visible to customers.
  startsAt        DateTime @map("starts_at")
  /// When reached, offer is auto-deactivated and hidden from customers.
  endsAt          DateTime @map("ends_at")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  merchant        Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([merchantId])
  @@index([isActive, startsAt, endsAt])
  @@map("merchant_offers")
}

/// Merchant product bundle (combo deal) with fixed price and image.
model MerchantBundle {
  id            String   @id @default(uuid()) @db.Uuid
  merchantId    String   @map("merchant_id") @db.Uuid
  title         String   @db.VarChar(255)
  titleAr       String?  @map("title_ar") @db.VarChar(255)
  description   String?  @db.Text
  descriptionAr String?  @map("description_ar") @db.Text
  price         Decimal  @db.Decimal(10, 2)
  imageUrl      String   @map("image_url") @db.VarChar(500)
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  merchant      Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  orderItems    OrderItem[]

  @@index([merchantId])
  @@index([isActive, sortOrder])
  @@map("merchant_bundles")
}

/// One open/close interval in the merchant's local timezone (see merchants.timezone). Weekday 1=Mon … 7=Sun.
model MerchantWorkingInterval {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @map("merchant_id") @db.Uuid
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  weekday    Int      @map("weekday")
  openLocal  String   @map("open_local") @db.VarChar(5)
  closeLocal String   @map("close_local") @db.VarChar(5)
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([merchantId])
  @@index([merchantId, weekday])
  @@map("merchant_working_intervals")
}

/// Estimated delivery window for a store (minutes). One row per merchant.
model MerchantDeliveryTime {
  id         String   @id @default(uuid()) @db.Uuid
  merchantId String   @unique @map("merchant_id") @db.Uuid
  minMinutes Int      @map("min_minutes")
  maxMinutes Int      @map("max_minutes")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@map("merchant_delivery_times")
}

model MerchantCategory {
  id          String    @id @default(uuid()) @db.Uuid
  merchantId  String    @map("merchant_id") @db.Uuid
  name        String    @db.VarChar(255)
  description String?   @db.Text
  nameAr      String?   @map("name_ar") @db.VarChar(255)
  descriptionAr String? @map("description_ar") @db.Text
  imageUrl    String?   @map("image_url") @db.VarChar(500)
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  merchant    Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  products    Product[]

  @@index([merchantId])
  @@map("merchant_categories")
}

model Product {
  id          String         @id @default(uuid()) @db.Uuid
  categoryId  String         @map("category_id") @db.Uuid
  name        String         @db.VarChar(255)
  description String?        @db.Text
  nameAr      String?        @map("name_ar") @db.VarChar(255)
  descriptionAr String?      @map("description_ar") @db.Text
  price       Decimal        @db.Decimal(10, 2)
  imageUrl    String?        @map("image_url") @db.VarChar(500)
  isActive    Boolean        @default(true) @map("is_active")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  category     MerchantCategory      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  images       ProductImage[]
  optionGroups ProductOptionGroup[]

  @@index([categoryId])
  @@index([isActive])
  @@map("products")
}

/// Per-product option set (e.g. Size). Choices add `priceModifier` on top of base effective price.
model ProductOptionGroup {
  id         String                @id @default(uuid()) @db.Uuid
  productId  String                @map("product_id") @db.Uuid
  name       String                @db.VarChar(255)
  nameAr     String?               @map("name_ar") @db.VarChar(255)
  isRequired Boolean               @default(true) @map("is_required")
  minSelect  Int                   @default(1) @map("min_select")
  maxSelect  Int                   @default(1) @map("max_select")
  sortOrder  Int                   @default(0) @map("sort_order")
  createdAt  DateTime              @default(now()) @map("created_at")
  updatedAt  DateTime              @updatedAt @map("updated_at")
  product    Product               @relation(fields: [productId], references: [id], onDelete: Cascade)
  choices    ProductOptionChoice[]

  @@index([productId])
  @@map("product_option_groups")
}

model ProductOptionChoice {
  id            String             @id @default(uuid()) @db.Uuid
  groupId       String             @map("group_id") @db.Uuid
  name          String             @db.VarChar(255)
  nameAr        String?            @map("name_ar") @db.VarChar(255)
  priceModifier Decimal            @default(0) @map("price_modifier") @db.Decimal(10, 2)
  sortOrder     Int                @default(0) @map("sort_order")
  isActive      Boolean            @default(true) @map("is_active")
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  group         ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@map("product_option_choices")
}

model ProductImage {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  url       String   @db.VarChar(500)
  sortOrder Int      @default(0) @map("sort_order")
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

/// Home / promo carousel image managed by super admin.
model Banner {
  id        String   @id @default(uuid()) @db.Uuid
  title     String?  @db.VarChar(255)
  titleAr   String?  @map("title_ar") @db.VarChar(255)
  imageUrl  String   @map("image_url") @db.VarChar(500)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("banners")
}

model SuperAdmin {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(255)
  email        String   @unique @db.VarChar(255)
  phone        String   @unique @db.VarChar(50)
  passwordHash String   @map("password_hash")
  isActive     Boolean  @default(true) @map("is_active")
  /// FCM device token for new-order push (admin dashboard).
  fcmToken     String?  @map("fcm_token") @db.VarChar(512)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("super_admins")
}

model Order {
  id              String       @id @default(uuid()) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  merchantId      String       @map("merchant_id") @db.Uuid
  addressId       String?      @map("address_id") @db.Uuid
  driverId        String?      @map("driver_id") @db.Uuid
  status          String?      @db.VarChar(50)
  subtotal        Decimal?     @db.Decimal(10, 2)
  deliveryFee     Decimal?     @map("delivery_fee") @db.Decimal(10, 2)
  total           Decimal?     @db.Decimal(10, 2)
  deliveryAddress String?      @map("delivery_address")
  notes           String?
  checkoutRef     String?      @map("checkout_ref") @db.VarChar(191)
  itemsSnapshot   Json?        @map("items_snapshot")
  createdAt        DateTime     @default(now()) @map("created_at")
  preparationTime  Int?         @map("preparation_time")
  /// Coupon applied at checkout (snapshot code kept for history even if coupon is later deleted).
  couponId        String?      @map("coupon_id") @db.Uuid
  couponCode      String?      @map("coupon_code") @db.VarChar(50)
  /// Amount deducted from subtotal by the coupon (stored for audit; not re-computed from coupon row).
  couponDiscount  Decimal?     @map("coupon_discount") @db.Decimal(10, 2)
  user             User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  merchant        Merchant     @relation(fields: [merchantId], references: [id], onDelete: Restrict)
  address         UserAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  driver          Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  coupon          Coupon?      @relation(fields: [couponId], references: [id], onDelete: SetNull)
  orderItems      OrderItem[]
  couponUsage     CouponUsage?

  @@index([userId])
  @@index([merchantId])
  @@index([driverId])
  @@index([status, driverId])
  @@index([addressId])
  @@index([couponId])
  @@index([merchantId, createdAt(sort: Desc)])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@index([merchantId, status, createdAt(sort: Desc)])
  @@map("orders")
}

model OrderItem {
  id          String          @id @default(uuid()) @db.Uuid
  orderId     String          @map("order_id") @db.Uuid
  productId   String?         @map("product_id") @db.Uuid
  bundleId    String?         @map("bundle_id") @db.Uuid
  productName String          @map("product_name") @db.VarChar(255)
  quantity    Int
  unitPrice   Decimal         @map("unit_price") @db.Decimal(10, 2)
  totalPrice  Decimal         @map("total_price") @db.Decimal(10, 2)
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bundle      MerchantBundle? @relation(fields: [bundleId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([bundleId])
  @@map("order_items")
}

/// Super-admin payout record — marks orders as paid without deleting history.
model EarningsSettlement {
  id              String    @id @default(uuid()) @db.Uuid
  participantType String    @map("participant_type") @db.VarChar(20)
  driverId        String?   @map("driver_id") @db.Uuid
  merchantId      String?   @map("merchant_id") @db.Uuid
  referenceCode   String    @unique @map("reference_code") @db.VarChar(32)
  periodFrom      DateTime  @map("period_from")
  periodTo        DateTime  @map("period_to")
  grossAmount     Decimal   @map("gross_amount") @db.Decimal(12, 2)
  netAmount       Decimal   @map("net_amount") @db.Decimal(12, 2)
  platformFee     Decimal   @map("platform_fee") @db.Decimal(12, 2)
  orderCount      Int       @map("order_count")
  orderIds        Json      @map("order_ids")
  status          String    @default("PAID") @db.VarChar(20)
  paidAt          DateTime  @default(now()) @map("paid_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  driver          Driver?   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  merchant        Merchant? @relation(fields: [merchantId], references: [id], onDelete: Cascade)

  @@index([driverId, status])
  @@index([merchantId, status])
  @@index([paidAt])
  @@map("earnings_settlements")
}

/// Key-value platform configuration (super-admin editable).
model AppSetting {
  key       String   @id @db.VarChar(100)
  value     String   @db.Text
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

/// Mobile app version config — single row (id = 1).
model AppVersion {
  id            Int      @id @default(1)
  latestVersion String   @default("1.0.0") @map("latest_version") @db.VarChar(20)
  minVersion    String   @default("1.0.0") @map("min_version") @db.VarChar(20)
  androidUrl    String?  @map("android_url") @db.Text
  iosUrl        String?  @map("ios_url") @db.Text
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("app_version")
}

/// Coupon code created by a super-admin. Applied at checkout for a percentage discount on subtotal.
/// Blocked when any cart item already carries a product-level discountPrice.
model Coupon {
  id              String       @id @default(uuid()) @db.Uuid
  /// Human-readable code customers enter (stored and matched case-insensitively, saved uppercase).
  code            String       @unique @db.VarChar(50)
  /// Percentage off the order subtotal (1–100).
  discountPercent Decimal      @map("discount_percent") @db.Decimal(5, 2)
  /// Free-text name of whoever created this coupon (e.g. "Marketing Team", "Ahmed").
  authorName      String       @map("author_name") @db.VarChar(255)
  isActive        Boolean      @default(true) @map("is_active")
  /// After this timestamp the coupon is rejected; null = no expiry.
  expiresAt       DateTime?    @map("expires_at")
  /// Maximum total redemptions allowed; null = unlimited.
  maxUsages       Int?         @map("max_usages")
  /// Denormalized total redemptions counter (updated inside the checkout transaction).
  usageCount      Int          @default(0) @map("usage_count")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  usages          CouponUsage[]
  orders          Order[]

  @@index([code])
  @@index([isActive, expiresAt])
  @@map("coupons")
}

/// One redemption event: one user × one coupon × one order (each pair is unique).
model CouponUsage {
  id             String   @id @default(uuid()) @db.Uuid
  couponId       String   @map("coupon_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  /// The order this coupon was redeemed on.
  orderId        String   @unique @map("order_id") @db.Uuid
  /// Actual money saved (coupon.discountPercent × order subtotal at redemption time).
  discountAmount Decimal  @map("discount_amount") @db.Decimal(10, 2)
  usedAt         DateTime @default(now()) @map("used_at")
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// A user may redeem the same coupon only once.
  @@unique([couponId, userId])
  @@index([couponId])
  @@index([userId])
  @@map("coupon_usages")
}

/// Delivery fee: flat fee inside includedKm, extra per km after, capped at maxFee.
model DeliveryFeeConfig {
  id               String   @id @default(uuid()) @db.Uuid
  name             String?  @db.VarChar(100)
  /// Minimum / flat fee for distance ≤ includedKm (e.g. 1.50).
  fixedFee         Decimal  @map("fixed_fee") @db.Decimal(12, 2)
  /// Km included in fixedFee only — no extra charge within this radius.
  includedKm       Decimal  @default(10) @map("included_km") @db.Decimal(8, 2)
  /// Bill extra distance in steps of N km beyond includedKm.
  kmUnit           Decimal  @default(1) @map("km_unit") @db.Decimal(8, 2)
  /// Price per kmUnit step after includedKm.
  feePerUnit       Decimal  @map("fee_per_unit") @db.Decimal(12, 2)
  /// Maximum total delivery fee (long trips never exceed this).
  maxFee           Decimal  @default(15) @map("max_fee") @db.Decimal(12, 2)
  /// Bill at most this many km — beyond it, distance does not increase the fee.
  maxKm            Decimal  @default(30) @map("max_km") @db.Decimal(8, 2)
  /// Saved example breakdown (updated on admin save).
  sampleBreakdown  Json?    @map("sample_breakdown")
  isActive         Boolean  @default(false) @map("is_active")
  sortOrder        Int      @default(0) @map("sort_order")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("delivery_fee_configs")
}

/// Singleton pickup config (id = 1). NOW window, service fee, timezone.
model PickupSetting {
  id            Int      @id @default(1)
  isEnabled     Boolean  @default(true) @map("is_enabled")
  timezone      String   @default("Africa/Tripoli") @db.VarChar(64)
  /// ASAP pickup ETA window in minutes (super admin).
  nowMinMinutes Int      @default(35) @map("now_min_minutes")
  nowMaxMinutes Int      @default(60) @map("now_max_minutes")
  /// Flat platform service fee added on top of deliveryFee.
  serviceFee    Decimal  @default(0) @map("service_fee") @db.Decimal(10, 2)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("pickup_settings")
}

/// Bookable scheduled windows. Weekday 1=Mon … 7=Sun, times in PickupSetting.timezone.
model PickupScheduleSlot {
  id         String   @id @default(uuid()) @db.Uuid
  weekday    Int
  startLocal String   @map("start_local") @db.VarChar(5)
  endLocal   String   @map("end_local") @db.VarChar(5)
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([weekday, isActive])
  @@map("pickup_schedule_slots")
}

/// Pickup-only delivery fee (separate from food delivery_fee_configs).
model PickupDeliveryFeeConfig {
  id              String   @id @default(uuid()) @db.Uuid
  name            String?  @db.VarChar(100)
  /// Minimum delivery fee (e.g. 100).
  fixedFee        Decimal  @map("fixed_fee") @db.Decimal(12, 2)
  includedKm      Decimal  @default(10) @map("included_km") @db.Decimal(8, 2)
  kmUnit          Decimal  @default(1) @map("km_unit") @db.Decimal(8, 2)
  feePerUnit      Decimal  @map("fee_per_unit") @db.Decimal(12, 2)
  /// Maximum delivery fee (e.g. 500).
  maxFee          Decimal  @map("max_fee") @db.Decimal(12, 2)
  maxKm           Decimal  @default(30) @map("max_km") @db.Decimal(8, 2)
  sampleBreakdown Json?    @map("sample_breakdown")
  isActive        Boolean  @default(false) @map("is_active")
  sortOrder       Int      @default(0) @map("sort_order")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("pickup_delivery_fee_configs")
}

/// Pickup-only blocked polygons. Independent from service_areas.
model PickupBlockedZone {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(255)
  /// FROM = cannot collect; TO = cannot drop off; BOTH = neither.
  appliesTo       String   @default("BOTH") @map("applies_to") @db.VarChar(10)
  boundaryGeoJson Json     @map("boundary_geo_json")
  isActive        Boolean  @default(true) @map("is_active")
  reason          String?  @db.VarChar(255)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([isActive, appliesTo])
  @@map("pickup_blocked_zones")
}

/// Courier job: from address → to address. No merchant.
model PickupOrder {
  id              String    @id @default(uuid()) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  driverId        String?   @map("driver_id") @db.Uuid
  /// NOW | SCHEDULED
  method          String    @db.VarChar(20)
  /// SCHEDULED | PENDING | DELIVERING | DISPATCHED | DELIVERED | CANCELLED
  status          String    @db.VarChar(50)
  description     String    @db.Text
  declaredValue   Decimal   @map("declared_value") @db.Decimal(10, 2)
  serviceFee      Decimal   @map("service_fee") @db.Decimal(10, 2)
  deliveryFee     Decimal   @map("delivery_fee") @db.Decimal(10, 2)
  total           Decimal   @db.Decimal(10, 2)
  distanceKm      Decimal   @map("distance_km") @db.Decimal(8, 3)
  pickupRef       String?   @map("pickup_ref") @db.VarChar(191)

  fromAddressLine String    @map("from_address_line") @db.VarChar(500)
  fromLatitude    Decimal   @map("from_latitude") @db.Decimal(10, 7)
  fromLongitude   Decimal   @map("from_longitude") @db.Decimal(10, 7)
  fromAddressId   String?   @map("from_address_id") @db.Uuid

  toAddressLine   String    @map("to_address_line") @db.VarChar(500)
  toLatitude      Decimal   @map("to_latitude") @db.Decimal(10, 7)
  toLongitude     Decimal   @map("to_longitude") @db.Decimal(10, 7)
  toAddressId     String?   @map("to_address_id") @db.Uuid

  /// Person who receives the package at the destination.
  recipientFullName String? @map("recipient_full_name") @db.VarChar(191)
  recipientPhone    String? @map("recipient_phone") @db.VarChar(32)

  scheduledAt     DateTime? @map("scheduled_at")
  etaMinMinutes   Int?      @map("eta_min_minutes")
  etaMaxMinutes   Int?      @map("eta_max_minutes")
  snapshot        Json?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  driver      Driver?      @relation(fields: [driverId], references: [id], onDelete: SetNull)
  fromAddress UserAddress? @relation("PickupFromAddress", fields: [fromAddressId], references: [id], onDelete: SetNull)
  toAddress   UserAddress? @relation("PickupToAddress", fields: [toAddressId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt(sort: Desc)])
  @@index([driverId, status])
  @@index([status, driverId])
  @@index([status, scheduledAt])
  @@map("pickup_orders")
}
