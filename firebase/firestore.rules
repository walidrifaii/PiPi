rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function orderRef(orderId) {
      return /databases/$(database)/documents/orders/$(orderId);
    }

    function orderExists(orderId) {
      return exists(orderRef(orderId));
    }

    function orderData(orderId) {
      return get(orderRef(orderId)).data;
    }

    // Participant = Firebase Auth uid matches userUid or driverUid on the order doc.
    function isParticipant(orderId) {
      return request.auth != null
        && orderExists(orderId)
        && (
          request.auth.uid == orderData(orderId).userUid
          || request.auth.uid == orderData(orderId).driverUid
        );
    }

    // Opening chat: client may merge userUid + driverUid from chat-ready API.
    function canSetParticipantMeta() {
      return request.auth != null
        && request.resource.data.userUid is string
        && request.resource.data.driverUid is string
        && (
          request.auth.uid == request.resource.data.userUid
          || request.auth.uid == request.resource.data.driverUid
        );
    }

    function isCallOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['call'])
        && request.resource.data.call is map;
    }

    match /orders/{orderId} {
      allow read: if isParticipant(orderId);

      allow create: if canSetParticipantMeta() && !orderExists(orderId);

      allow update: if request.auth != null
        && orderExists(orderId)
        && (
          isParticipant(orderId)
          || canSetParticipantMeta()
        )
        && (canSetParticipantMeta() || isCallOnlyUpdate());

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isParticipant(orderId);
        allow create: if isParticipant(orderId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt is number;
        allow update, delete: if false;
      }
    }
  }
}
