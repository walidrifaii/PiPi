rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function orderDoc(orderId) {
      return get(/databases/$(database)/documents/orders/$(orderId));
    }

    function orderData(orderId) {
      return orderDoc(orderId).data;
    }

    function isOrderParticipant(orderId) {
      return request.auth != null
        && orderDoc(orderId).exists
        && orderData(orderId).keys().hasAll(['userUid', 'driverUid'])
        && (
          request.auth.uid == orderData(orderId).userUid
          || request.auth.uid == orderData(orderId).driverUid
        );
    }

    function isMetaOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['userUid', 'driverUid', 'active', 'updatedAt']);
    }

    function isCallOnlyUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['call'])
        && request.resource.data.call is map
        && request.resource.data.call.keys().hasAll(
          ['callId', 'channel', 'status', 'startedBy', 'startedAt', 'active']
        );
    }

    match /orders/{orderId} {
      allow read: if isOrderParticipant(orderId);

      // Client applies meta from GET .../chat-ready (JWT-protected API).
      allow create: if request.auth != null
        && !orderDoc(orderId).exists
        && request.resource.data.keys().hasAll(['userUid', 'driverUid'])
        && (
          request.auth.uid == request.resource.data.userUid
          || request.auth.uid == request.resource.data.driverUid
        );

      allow update: if request.auth != null
        && orderDoc(orderId).exists
        && (
          (isOrderParticipant(orderId) && isCallOnlyUpdate())
          || (isMetaOnlyUpdate()
            && (
              request.auth.uid == request.resource.data.userUid
              || request.auth.uid == request.resource.data.driverUid
            ))
        );

      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isOrderParticipant(orderId);
        allow create: if isOrderParticipant(orderId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000
          && request.resource.data.createdAt is number;
        allow update, delete: if false;
      }
    }
  }
}
